{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "XorMon",
  "id": "xorux-xormon-datasource",
  "metrics": true,
  "info": {
    "description": "It provides access to XorMon data for time-series graphs, alerts, and capacity analysis.",
    "author": {
      "name": "Xorux"
    },
    "keywords": [
      "datasource",
      "xormon",
      "monitoring",
      "infrastructure",
      "storage",
      "san",
      "lan",
      "virtualization",
      "capacity",
      "performance"
    ],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      { "name": "Website", "url": "https://www.xormon.com" },
      { "name": "repository", "url": "https://github.com/XoruX/grafana-plugin" },
      { "name": "raise issue", "url": "https://github.com/XoruX/grafana-plugin/issues" },
      { "name": "license", "url": "https://github.com/XoruX/grafana-plugin/blob/main/LICENSE" }
    ],
    "screenshots": [
      { "name": "Dashboard", "path": "img/dashboard.png" },
      { "name": "Data source configuration", "path": "img/datasource-configuration.png" },
      { "name": "Health status query", "path": "img/hs-settings.png" }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=12.3.0",
    "plugins": []
  },
  "routes": [
    {
      "path": "api",
      "url": "{{ .JsonData.protocol }}://{{ .JsonData.host }}:{{ .JsonData.port }}/api/public/v1",
      "headers": [
        {
          "name": "apiKey",
          "content": "{{ .SecureJsonData.apiKey }}"
        }
      ]
    }
  ]
}
